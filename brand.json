  "typography": {
    "_source": "Brand Identity System & Guidelines, pages 15–16",
    "display": {
      "family": "Dharma Gothic E",
      "weights": ["ExBold", "Bold"],
      "case": "ALL CAPS — always",
      "use": "Display only. Calls to action, headlines, titling.",
      "files": "assets/fonts/dharma-gothic/",
      "webFiles": "assets/fonts/web/DharmaGothicE-*.woff2"
    },
    "body": {
      "family": "ITC Clearface",
      "postscriptName": "ClearfaceStd",
      "weights": ["Regular", "Italic", "Bold", "BoldItalic", "Heavy", "HeavyItalic", "Black", "BlackItalic"],
      "primaryWeight": "Regular",
      "sizePrint": "11pt (standard body per letterhead spec)",
      "sizeWeb": "16-18px",
      "lineHeight": "1.5-1.65",
      "use": "All body copy and long-form text",
      "files": "assets/fonts/clearface/"
    },
    "caption": {
      "family": "Frutiger Next Pro",
      "weights": ["Light", "LightItalic", "Regular", "Italic", "Bold", "BoldItalic"],
      "maxSize": "10pt — use only at 10pt or smaller",
      "use": "Captions, credits, fine print, supporting labels",
      "files": "assets/fonts/frutiger-next/",
      "webFiles": "assets/fonts/web/FrutigerNextCom-*.woff2"
    },
    "decorative": {
      "family": "Teddy Regular",
      "use": "Decorative/accent use only — not for body or headlines",
      "files": "assets/fonts/teddy/"
    }
  },

  "logo": {
    "_source": "Brand Identity System & Guidelines, page 37",
    "marks": ["wordmark", "stamp-brand", "stamp-tr-initials"],
    "clearSpace": "2x the width of the crossbar of the 'T' in 'Theodore' on all sides",
    "minimumHeight": "0.75 inches (primary wordmark)",
    "colorVersions": [
      "black",
      "dark-gray",
      "white",
      "black-on-white",
      "dark-gray-on-white",
      "white-on-black",
      "white-on-dark-gray",
      "orange",
      "green",
      "pink",
      "gray-sky"
    ],
    "formats": {
      "screen": ["SVG", "PNG"],
      "print": ["EPS", "PDF"],
      "sourceFiles": ["AI"]
    },
    "files": {
      "wordmarks": "logos/wordmarks/",
      "primary": "logos/primary/",
      "stamps": "logos/monograms/",
      "templates": "logos/lockups/"
    }
  },

